# Public deployment settings (docker-compose.yml + Caddyfile) - only needed once you're
# deploying to a real server with a real domain, not for local development.
DOMAIN=dashboard.example.com
ACME_EMAIL=you@example.com

# GitHub reporter settings
TARGET_GITHUB_USERNAME=sande231
TARGET_GH_PAT=
REPORT_RECIPIENTS=you@example.com
GMAIL_SMTP_USER=you@example.com
GMAIL_SMTP_PASS=

# Ingestion server settings
INGESTION_API_KEY=replace-with-secret
INGESTION_API_KEY_HEADER=X-API-KEY
LOG_LEVEL=INFO
LOCAL_QUEUE_DB=.telemetry_queue.db
# Only needed if you want /dashboard reachable from something other than this machine
# (e.g. LAN or a public deployment). Defaults to 127.0.0.1 otherwise.
INGESTION_BIND_HOST=127.0.0.1

# Dashboard login (separate from INGESTION_API_KEY, which is for agent-to-server calls).
# Required before the dashboard is reachable from anywhere but localhost - without both
# set, /dashboard fails closed with a 503 rather than opening up unauthenticated.
DASHBOARD_USERNAME=replace-with-a-username
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-real-password'))"
DASHBOARD_PASSWORD_HASH=replace-with-a-generated-hash
# Dedicated Flask session-signing key (falls back to INGESTION_API_KEY if unset).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-random-64-char-hex-string
# Set to 1 only once the dashboard is served over real HTTPS (behind Caddy/Nginx) -
# forces the session cookie to require TLS. Leave unset for local http:// testing.
FORCE_HTTPS_COOKIES=

# Main agent settings
INGESTION_URL=http://localhost:5000
INGESTION_API_KEY=replace-with-secret
INGESTION_API_KEY_HEADER=X-API-KEY
INGESTION_RETRY_ATTEMPTS=5
INGESTION_RETRY_BACKOFF=1.0
AGENT_CONTROL_URL=http://localhost:9000/control

# Canvas OAuth settings
CANVAS_BASE_URL=https://your-school.instructure.com
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://localhost:8080/canvas/oauth/callback
CANVAS_OAUTH_HOST=0.0.0.0
CANVAS_OAUTH_PORT=8080
CANVAS_OAUTH_SCOPES=
CANVAS_REPLACE_TOKENS=false
CANVAS_TOKEN_STORE=.canvas_tokens/canvas_token.json
CANVAS_ACCESS_TOKEN=

# Canvas Tutor adapter settings
CANVAS_TUTOR_AGENT_ID=canvas-tutor-agent
CANVAS_TUTOR_VERSION=1.0.0
CANVAS_TUTOR_HEARTBEAT_INTERVAL_SECONDS=60
CANVAS_TUTOR_SESSION_COUNT=0
CANVAS_TUTOR_LATENCY_MS=0
CANVAS_TUTOR_EXAMPLE_CYCLE=false
CANVAS_TUTOR_VERIFY_API=false
RECIPIENTS=ops@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
